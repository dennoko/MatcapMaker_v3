{
  "name": "matcap-maker",
  "private": true,
  "version": "4.0.0",
  "type": "module",
  "description": "Matcap texture authoring tool",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:web": "vite build --mode web --outDir dist-web",
